{
  "name": "needlelove",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
